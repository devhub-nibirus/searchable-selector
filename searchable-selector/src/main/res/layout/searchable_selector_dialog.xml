<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/searchable_selector_bg_dialog_soft"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingVertical="10dp">

    <LinearLayout
        android:id="@+id/contentBuscar"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/searchable_selector_bg_input_search_soft"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/searchable_selector_search"
            android:src="@drawable/searchable_selector_ic_search" />

        <EditText
            android:id="@+id/etBuscar"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="@string/searchable_selector_search"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:padding="0dp"
            android:singleLine="true"
            android:textColor="@color/searchable_selector_colorTextPrimary"
            android:textColorHint="@color/searchable_selector_colorTextHint"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Visible únicamente para selección múltiple -->
    <LinearLayout
        android:id="@+id/contentSelectionActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:visibility="visible">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSelectAll"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="@string/searchable_selector_select_all"
            android:textAllCaps="false"
            android:textColor="@color/searchable_selector_colorTextPrimary"
            android:textSize="12sp"
            app:cornerRadius="8dp"
            app:strokeColor="@color/searchable_selector_colorDividerSoft"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearSelection"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:enabled="false"
            android:text="@string/searchable_selector_clear"
            android:textAllCaps="false"
            android:textColor="@color/searchable_selector_colorTextPrimary"
            android:textSize="12sp"
            app:cornerRadius="8dp"
            app:strokeColor="@color/searchable_selector_colorDividerSoft"
            app:strokeWidth="1dp" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_marginTop="6dp">

        <ListView
            android:id="@+id/lvItems"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/searchable_selector_bg_list_soft"
            android:cacheColorHint="@android:color/transparent"
            android:clipToPadding="false"
            android:divider="@color/searchable_selector_colorDividerSoft"
            android:dividerHeight="0.5dp"
            android:fadingEdgeLength="8dp"
            android:listSelector="@drawable/searchable_selector_bg_item_selector_soft"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:scrollbarStyle="outsideOverlay" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/searchable_selector_empty"
            android:textColor="@color/searchable_selector_colorTextHint"
            android:textSize="14sp"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>